# Big / local-only things — never commit these.
# Videos live OUTSIDE the repo by default (sibling football-video/ folder),
# so the editor never indexes them. data/ still ignored for CSVs etc.
data/*.mp4
data/*.mov
data/*.mkv
data/*.pt
data/*.csv
data/*.png
data/heat*
data/*.db
data/lineups/
*.sqlite
!data/.gitkeep

# Downloaded archives / generated bundles — keep binaries out of Git.
*.zip

# Python
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
